{
  "name": "tes-hub-backend",
  "version": "1.0.0",
  "description": "Backend API for TES Knowledge Hub",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:push": "drizzle-kit push",
