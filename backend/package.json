    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "^6.0.12",
    "morgan": "^1.10.1",
    "pg": "^8.13.3",
    "resend": "^6.37.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
